# Copy to .env, or run: npm run setup:wallets
# Never commit .env. The Arkiv access key is part of the RPC URL, so treat it as a secret.

PORT=8787
CORS_ORIGIN=http://localhost:3000

# Free key: https://hub.arkiv.network/access-keys
ARKIV_ACCESS_KEY=
ARKIV_PRIVATE_KEY=

SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ENS_ROOT_LABEL=commentdesk
ENS_OPERATOR_PRIVATE_KEY=
ENS_MODERATOR_PRIVATE_KEY=

# The public gateway needs no batch. For your own Bee node, set its URL and batch ID.
SWARM_BEE_URL=https://api.gateway.ethswarm.org
SWARM_BATCH_ID=

# Comma-separated moderator wallets. The moderator key above is included automatically.
MODERATOR_ADDRESSES=

GRACE_DAYS=7
MAX_COMMENTS_PER_TOPIC=1
POLICY_VERSION=1

# Leave empty until the World gate lands. "dev" skips proofs and marks records dev:
WORLD_GATE=

# ---- World gates ----
# Copy to backend/.env. Never commit real values; none of these go to the browser.

WORLD_PORT=4000
# The browser origin. Agent Pass callbacks redirect here; https => Secure session cookie.
FRONTEND_ORIGIN=https://localhost:3000
# openssl rand -hex 32
SESSION_SECRET=
DATA_FILE=data/world-gate.json

# ---- IDKit 4 (developer.world.org) ----
# One app; app_id + rp_id are public, the signing key is a backend-only secret.
WORLD_ID_APP_ID=app_
WORLD_ID_RP_ID=rp_
WORLD_ID_SIGNING_KEY=
# production = real World App. staging = World ID Simulator only (the environments must match
# or proofs silently fail â€” see README "Critical setup trap").
WORLD_ID_ENVIRONMENT=production
# Credential for the one-human-one-name join proof: proof_of_human (Orb) | selfie (Selfie Check)
WORLD_ID_JOIN_CREDENTIAL=proof_of_human
# Accept World ID 3.0 Orb proofs as a fallback for Proof of Human (users on older World App).
WORLD_ID_ALLOW_LEGACY_PROOFS=false
WORLD_ID_REQUEST_TTL_SECONDS=300

# ---- World ID Agent Pass (auth.world.org/portal) ----
# Sandbox issuer for testing: https://sandbox.auth.world.org (proofs there are NOT real humans).
AGENT_PASS_ISSUER=https://auth.world.org
AGENT_PASS_CLIENT_ID=
AGENT_PASS_CLIENT_SECRET=
# Must match what the client was registered with: client_secret_basic | client_secret_post
AGENT_PASS_CLIENT_AUTH=client_secret_basic
# Register exactly this (HTTPS) in the portal. The frontend proxies /api/* to this backend.
AGENT_PASS_REDIRECT_URI=https://localhost:3000/api/agent-pass/callback
# Accepted authentication classes (space/comma separated), checked against the ID token's acr.
# orb-face additionally requires a live Face Auth on the phone.
AGENT_PASS_ACR_VALUES=https://world.org/oidc/acr/orb
# How long the human has to finish the confirm before the agent's draft is discarded.
AGENT_PASS_CONFIRM_TTL_SECONDS=180
AGENT_DRAFT_TTL_SECONDS=900
